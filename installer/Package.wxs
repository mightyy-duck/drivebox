<?xml version="1.0" encoding="UTF-8"?>
<!-- WiX Toolset 5. Build with installer\build-installer.ps1 -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="DriveBox"
           Manufacturer="mightyy-duck"
           Version="1.0.2.0"
           UpgradeCode="0D008DDA-385B-4107-9876-BE6321A4AC89"
           Scope="perMachine"
           InstallerVersion="500"
           Compressed="yes">

    <SummaryInformation Description="DriveBox - disk usage dashboard" Manufacturer="mightyy-duck" />

    <!-- installing a newer version upgrades in place; the UpgradeCode above must never change -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of DriveBox is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="AppIcon.ico" SourceFile="$(var.IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/mightyy-duck/drivebox" />
    <Property Id="ARPHELPLINK" Value="https://github.com/mightyy-duck/drivebox/issues" />

    <!-- standard wizard: welcome, license, install folder, progress -->
    <WixVariable Id="WixUILicenseRtf" Value="license.rtf" />
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="DriveBox" />
    </StandardDirectory>

    <Feature Id="Main" Title="DriveBox" Level="1">
      <Component Directory="INSTALLFOLDER" Guid="*">
        <File Id="DriveBoxExe" Source="$(var.SourceDir)\DriveBox.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="DriveBox" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon.ico" Advertise="yes" />
          <Shortcut Id="DesktopShortcut" Directory="DesktopFolder" Name="DriveBox" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon.ico" Advertise="yes" />
        </File>
      </Component>
    </Feature>
  </Package>
</Wix>
