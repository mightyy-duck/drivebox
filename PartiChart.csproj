<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>PartiChart</AssemblyName>
    <RootNamespace>PartiChart</RootNamespace>
    <Version>1.0.1</Version>
    <AssemblyVersion>1.0.1.0</AssemblyVersion>
    <FileVersion>1.0.1.0</FileVersion>
    <InformationalVersion>1.0.1</InformationalVersion>
    <Product>PartiChart</Product>
    <Authors>mightyy-duck</Authors>
    <Company>mightyy-duck</Company>
    <Copyright>Copyright (c) 2026 mightyy-duck</Copyright>
    <Description>Disk usage dashboard for Windows: partition and folder maps, 2D and 3D charts, apps and games storage, live CPU and GPU temperature and power.</Description>
    <RepositoryUrl>https://github.com/mightyy-duck/partichart</RepositoryUrl>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
  </ItemGroup>
</Project>
